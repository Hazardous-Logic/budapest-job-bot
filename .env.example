# Create a Telegram bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# IMAP details for the mailbox that receives LinkedIn job alerts.
# For Gmail, use imap.gmail.com and an App Password (with 2-Step Verification enabled).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Daily digest time in the configured timezone (24-hour clock).
TIMEZONE=Europe/Budapest
DAILY_HOUR=9
POLL_SECONDS=300
# DATABASE_PATH=jobs.sqlite3

